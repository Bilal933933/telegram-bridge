# Telegram
BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
ALLOWED_ID=000000000
# Supergroup with Topics enabled; bot must be admin with "Manage Topics".
# Leave 0 to keep everything in the private chat, or run /setup inside the group.
GROUP_CHAT_ID=0

# Qoder engine
QODER_DIR=C:\path\to\your\project
QODER_BIN=qoder
QODER_PERMISSION_MODE=accept_edits
QODER_TIMEOUT=900

# OpenCode engine
OPENCODE_BIN=C:\path\to\opencode.exe
OPENCODE_PROVIDER=opencode
OPENCODE_MODEL=deepseek-v4.1-flash-free
OPENCODE_TIMEOUT=600

# Streaming
STREAM_INTERVAL=1.6
